# ============================================================
# Memecoin Agent v3.0 - .gitignore
# ============================================================

# Variables de entorno (NUNCA commitear)
config/.env
config/.env.local
config/.env.*.local

# Datos y logs
logs/
*.log
nohup.out

# Modelos entrenados (pesos grandes)
models/*.pkl
models/*.joblib
models/*.onnx

# Datos temporales
data/
tmp/
*.tmp

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Circuit breaker y estado
/tmp/agent.pause
/tmp/agent.mode

# Archivos grandes
*.csv
*.parquet

# Credenciales
*.pem
*.key
wallets/
*.wif

# Docker
.dockerignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtualenv
venv/
.env/
.venv/

# Jupyter Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/