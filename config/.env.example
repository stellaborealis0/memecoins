# ============================================================
# Memecoin Agent v3.0 - Configuración de Entorno
# ============================================================
# IMPORTANTE: Copia este archivo a .env y rellena con tus valores
# NUNCA commitear el archivo .env real

# ============================================================
# --- Base de datos ---
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memecoin_db
POSTGRES_USER=memecoin_user
POSTGRES_PASSWORD=CAMBIA_ESTO

# ============================================================
# --- Solana RPC ---
# ============================================================
HELIUS_API_KEY=TU_HELIUS_API_KEY
BITQUERY_API_KEY=TU_BITQUERY_API_KEY
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# ============================================================
# --- Yellowstone gRPC (v3.0 streaming) ---
# ============================================================
# Chainstack free tier endpoint para streaming en tiempo real
YELLOWSTONE_ENDPOINT=wss://grpc.geyser.finance
YELLOWSTONE_TOKEN=TU_YELLOWSTONE_TOKEN

# ============================================================
# --- PumpPortal WebSocket (fallback) ---
# ============================================================
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# ============================================================
# --- Jito Block Engine (MEV protection) ---
# ============================================================
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_SOL=0.01

# ============================================================
# --- LLM (LiteLLM Gateway SAA) ---
# ============================================================
LITELLM_ENDPOINT=http://100.68.1.180:8080/v1
LITELLM_MODEL=qwen3.5
LITELLM_API_KEY=TU_KEY_LOCAL

# ============================================================
# --- Telegram ---
# ============================================================
TELEGRAM_BOT_TOKEN=TU_TOKEN_DE_BOTFATHER
TELEGRAM_ALLOWED_USERS=TU_TELEGRAM_USER_ID

# ============================================================
# --- Modo operativo ---
# ============================================================
EXECUTION_MODE=research
# valores: research | execution
# NUNCA cambiar a execution sin validación previa de 8 semanas
# Por defecto: research (solo alertas y análisis)

MAX_POSITION_SOL=0.5
# Solo activo si EXECUTION_MODE=execution
# LÍMITE HARD: 1 SOL por trade (hardcodeado en execution_engine.py)

# ============================================================
# --- Wallet para ejecución real ---
# ============================================================
# NUNCA usar en producción sin validación completa
# WIF (Wallet Import Format) para firmar transacciones
WALLET_PRIVATE_KEY=TU_WIF_WALLET

# ============================================================
# --- Execution PIN (seguridad) ---
# ============================================================
# PIN de 6 dígitos para activar modo execution
EXECUTION_PIN=123456

# ============================================================
# --- Circuit breaker ---
# ============================================================
CIRCUIT_BREAKER_LOSSES=3
# Número de pérdidas consecutivas para activar circuit breaker

# ============================================================
# --- Features y modelos ---
# ============================================================
FEATURE_VERSION=v1-onchain-v73
MODELS_DIR=/data/models

# ============================================================
# --- Backfill ---
# ============================================================
BACKFILL_DAYS=90
BACKFILL_MODE=false
# Poner true solo durante el primer backfill

# ============================================================
# --- Kaggle (opcional, para backfill rápido) ---
# ============================================================
KAGGLE_USERNAME=optional
KAGGLE_KEY=optional

# ============================================================
# --- RugCheck API ---
# ============================================================
RUGCHECK_API_BASE=https://api.rugcheck.xyz/v1

# ============================================================
# --- Configuración de capas ---
# ============================================================
SNIPER_ENABLED=false
# Activar/desactivar Capa A (Sniper Engine)

SPRAY_ENABLED=false
# Activar/desactivar copy-trading de whales

STREAM_SOURCE=grpc
# valores: grpc | websocket
# Fuente de streaming on-chain

# ============================================================
# --- Umbrales del Sniper Engine ---
# ============================================================
SNIPER_TX_VELOCITY_THRESHOLD=3.0
SNIPER_WALLET_THRESHOLD=10
SNIPER_BUY_RATIO_THRESHOLD=0.70

# ============================================================
# --- Risk Filter ---
# ============================================================
RISK_THRESHOLD=0.65
# Score máximo aceptable para permitir un trade